# Copy this file to .env before the first npm start.
# Never put a real key in .env.example or commit .env.
PORT=3000

# Only the chat assistant needs this key. Local YOLO runs without it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Usually leave these unset: .venv and data/smartkoz.db are detected automatically.
# PYTHON=C:/path/to/SmartKoz_amygdala/.venv/Scripts/python.exe
# SMARTKOZ_DB=C:/path/to/SmartKoz_amygdala/data/smartkoz.db
# SMARTKOZ_UPLOADS=C:/path/to/SmartKoz_amygdala/data/uploads
# HELMET_MODEL_PATH=C:/path/to/SmartKoz_amygdala/microdream/dreameye.pt

# For a phone camera over LAN, both certificate paths are needed.
# The certificate must be trusted by the phone. See SMART_HELMET.md.
# TLS_CERT_FILE=data/tls/smartkoz.pem
# TLS_KEY_FILE=data/tls/smartkoz-key.pem

# Optional custom first administrator, applied to an empty database.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters

# For production use HTTPS and the custom administrator settings above.
# NODE_ENV=production
